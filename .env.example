# ===== Database =====
DATABASE_URL=postgresql://animatai:animatai@postgres:5432/animatai
POSTGRES_DB=animatai
POSTGRES_USER=animatai
POSTGRES_PASSWORD=animatai

# ===== Auth =====
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=

# ===== Message broker =====
RABBITMQ_USER=animatai
RABBITMQ_PASS=animatai

# ===== Cache / pub-sub =====
REDIS_URL=redis://redis:6379

# ===== Object storage (MinIO) =====
MINIO_URL=minio:9000
MINIO_USER=animatai
MINIO_PASS=animatai_secret
MINIO_BUCKET=animatai

# ===== Email (Resend) =====
RESEND_API_KEY=
FROM_EMAIL=AnimatAI <noreply@yourdomain.com>

# ===== External AI (per-request, supplied by frontend headers) =====
# FAL_KEY and OPENROUTER_API_KEY are NOT stored server-side.
# Users pass them via X-Fal-Key / X-Openrouter-Key request headers.

# ===== App =====
PORT=3000
