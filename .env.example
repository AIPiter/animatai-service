# ===== Database =====
DATABASE_URL=postgresql://animatai:animatai@postgres:5432/animatai
POSTGRES_PASSWORD=animatai

# ===== Auth =====
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ===== Email (Resend) =====
# Sign up at resend.com → API Keys → Create API Key
RESEND_API_KEY=
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing)
FROM_EMAIL=AnimatAI <noreply@yourdomain.com>

# ===== fal.ai =====
# Sign up at fal.ai → Dashboard → API Keys → Create key
FAL_KEY=your_fal_api_key_here

# ===== Optional overrides =====
PORT=3000
